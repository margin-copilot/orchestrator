# Names only; Container Apps sets the values (infra/bicep/spike/main.bicep). Local run: ADAPTERS=fake.
ADAPTERS=
TENANT_ID=
CLIENT_ID=
AZURE_CLIENT_ID=
ALLOWED_CALLERS=
DATA_AGENT_URL=
DATA_AGENT_SCOPE=
POLICY_AGENT_URL=
POLICY_AGENT_SCOPE=
ACTION_AGENT_URL=
ACTION_AGENT_SCOPE=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
TABLE_ENDPOINT=
CONVERSATIONS_TABLE=
ALLOWED_ORIGINS=
# Optional (D-043): Application Insights connection string; traces export with AZURE_CLIENT_ID's
# managed identity. Unset: the service runs untraced.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional: seconds an open stream may finish after SIGTERM (default 25). Infra sets 235, inside the
# Container Apps termination grace of 240.
STREAM_SHUTDOWN_GRACE_SECONDS=
